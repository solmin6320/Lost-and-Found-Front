# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────
# API 주소의 앞부분
# ─────────────────────────────────────────────────────────────
# 비워 두는 것이 기본값이다.
# 비어 있으면 요청이 `/api/posts` 같은 상대경로로 나가고,
#   - 개발 : vite.config.ts 의 프록시가 백엔드(8080)로 넘긴다
#   - 배포 : CloudFront 가 /api/* 를 ALB 로 넘긴다 (기능명세서 11장)
# 두 환경 모두 브라우저 기준 단일 오리진이 되므로
# CORS preflight 가 없고 SameSite=Strict 리프레시 쿠키가 정상 동작한다.
VITE_API_BASE_URL=

# 백엔드를 직접 때려서 CORS 경로를 확인하고 싶을 때만 아래처럼 채운다.
# VITE_API_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────
# 개발 서버 프록시 대상 (개발 전용, 빌드 결과물에는 들어가지 않는다)
# ─────────────────────────────────────────────────────────────
# `VITE_` 를 붙이지 않는다. 붙은 값은 브라우저 코드(import.meta.env)로 공개된다.
# 이 값은 vite.config.ts(개발 서버)만 읽는다. 비우면 http://localhost:8080
DEV_PROXY_TARGET=http://localhost:8080
